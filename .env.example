# Maksymalny rozmiar przesyłanego pliku (w MB)
MAX_FILE_SIZE_MB=10

# Adres API kompatybilnego z OpenAI (/chat/completions), domyślnie EdenAI
LLM_BASE_URL=https://api.edenai.run/v3

# Klucz API EdenAI (wymagany)
LLM_API_KEY=

# Nazwa modelu (z prefiksem dostawcy, żeby EdenAI nie kierował zapytań do innego)
LLM_MODEL=google/gemma-4-31b-it

# Limit czasu oczekiwania na odpowiedź modelu (w sekundach)
LLM_TIMEOUT_S=300

# Ten sam model u innego dostawcy, używany, gdy LLM_MODEL odpowie HTTP 429 (limit zapytań); pusty = bez zapasowego
LLM_FALLBACK_MODEL=deepinfra/google/gemma-4-31B-it

# Język OCR (Tesseract)
OCR_LANG=pol

# Czy emitować walidatory pól w wynikowym JSON-ie
EMIT_VALIDATORS=true