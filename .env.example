# Template for local configuration. Copy it:  cp .env.example .env
# and fill in the values. .env is in .gitignore – never commit real keys.

# --- LLM (any OpenAI-compatible /chat/completions API, e.g. Groq) ---
# Groq key: https://console.groq.com/keys, models: https://console.groq.com/docs/models
# Local Ollama instead: LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_MODEL from `ollama list`, any LLM_API_KEY
LLM_BASE_URL=https://api.groq.com/openai/v1
# required
LLM_API_KEY=
# required
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=120

# --- required by the app ---
# e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# --- optional (defaults shown) ---
# MAX_FILE_SIZE_MB=10
# OCR_LANG=pol
# EMIT_VALIDATORS=true
