# Maksymalny rozmiar przesyłanego pliku (w MB)
MAX_FILE_SIZE_MB=10

# Adres API kompatybilnego z OpenAI (/chat/completions)
# W docker-compose.yml wartość jest nadpisywana na http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1

# Klucz API (dla lokalnej Ollamy wystarczy dowolna niepusta wartość, np. ollama)
LLM_API_KEY=ollama

# Nazwa modelu w Ollamie
LLM_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:UD-Q8_K_XL

# Limit czasu oczekiwania na odpowiedź modelu (w sekundach)
LLM_TIMEOUT_S=300

# Język OCR (Tesseract)
OCR_LANG=pol

# Czy emitować walidatory pól w wynikowym JSON-ie
EMIT_VALIDATORS=true